rules_version = '2';
// Cada usuario solo puede leer, escribir y borrar su propio documento users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['perfil', 'gasto', 'actualizado'])
        && request.resource.data.perfil is map
        && request.resource.data.gasto is number;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
