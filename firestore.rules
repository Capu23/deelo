rules_version = '2';
// Cada usuario solo puede leer, escribir y borrar su propio documento users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['perfil', 'gasto', 'actualizado'])
        && request.resource.data.perfil is map
        && request.resource.data.gasto is number;
    }
    // Comentarios de "Contanos qué mejorar": cualquiera puede crear uno (con o sin cuenta); nadie puede leerlos
    // desde la página. Se leen desde la consola de Firebase.
    match /comentarios/{id} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'texto', 'contacto', 'vista', 'uid', 'fecha'])
        && request.resource.data.tipo in ['idea', 'error', 'otro']
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 3 && request.resource.data.texto.size() <= 1500
        && request.resource.data.contacto is string && request.resource.data.contacto.size() <= 120
        && request.resource.data.vista is string && request.resource.data.vista.size() <= 20
        && request.resource.data.fecha == request.time
        && (request.resource.data.uid == null || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
